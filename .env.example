NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key from your Paystack dashboard (Settings > API Keys & Webhooks).
# Never prefix this with NEXT_PUBLIC_ — it must stay server-side only.
PAYSTACK_SECRET_KEY=

# Server-only service_role key from Supabase Project Settings > API. Bypasses
# RLS — required for order creation, inventory decrement, and the admin
# orders view. Never prefix this with NEXT_PUBLIC_ or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: powers order confirmation emails. Get a key at resend.com.
RESEND_API_KEY=
